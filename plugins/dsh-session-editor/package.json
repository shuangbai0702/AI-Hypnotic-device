{
  "name": "@shuangbai/dsh-session-editor",
  "description": "Session context/history/summary editor for shuangbai-dsh",
  "version": "0.4.1",
  "bin": { "dsh-session-editor-install": "./install.mjs" },
  "files": ["lib/*.js", "lib/*.mjs", "install.mjs", "host-adapter.mjs", "README.md", "AGENT.md"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
