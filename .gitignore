# Track only the distributable project. Local runtime/data stay outside Git.
/*
!/.gitignore
!/README.md
!/package.json
!/plugins/
/plugins/*
!/plugins/dsh-session-editor/
/plugins/dsh-session-editor/*
!/plugins/dsh-session-editor/package.json
!/plugins/dsh-session-editor/README.md
!/plugins/dsh-session-editor/AGENT.md
!/plugins/dsh-session-editor/install.mjs
!/plugins/dsh-session-editor/host-adapter.mjs
!/plugins/dsh-session-editor/lib/
/plugins/dsh-session-editor/lib/*
!/plugins/dsh-session-editor/lib/*.js
!/plugins/dsh-session-editor/lib/*.mjs
!/packaging/
/packaging/*
!/packaging/windows/
/packaging/windows/*
!/packaging/windows/Build.ps1
!/packaging/windows/Installer.ps1
!/packaging/windows/Discovery.ps1
!/packaging/windows/Desktop.ps1
!/packaging/windows/Update.ps1
!/packaging/windows/assets/
/packaging/windows/assets/*
!/packaging/windows/assets/installer-art.png
!/packaging/windows/Launcher.cs
!/packaging/windows/README.md
!/scripts/
/scripts/*
!/scripts/check-release.mjs
!/tests/
/tests/*
!/tests/memory-workbench.mjs
!/tests/workbench-client.mjs
!/tests/memory-assistant.mjs
!/tests/context-coverage.mjs
!/tests/session-editor-regression.mjs
!/tests/assistant-edit-wire.mjs
!/tests/memory-ergonomics-client.mjs
!/tests/native-chat-projection.mjs
!/tests/storage-integrity.mjs
!/tests/runtime-diagnostics.mjs
!/tests/installer-transaction.mjs
!/tests/native-session-e2e.mjs
!/tests/windows-installation-e2e.ps1
!/tests/windows-discovery.ps1
!/tests/windows-update.ps1
!/tests/desktop-installation.mjs
!/tests/windows-desktop-e2e.ps1
!/tests/windows-health-rollback.ps1
!/docs/
/docs/*
!/docs/VALIDATION.md
!/docs/GITHUB-PUBLISH-PLAN.md
!/docs/RELIABILITY-PLAN.md
!/docs/RELIABILITY-VALIDATION.md

# Never include runtime secrets or machine-specific dependency links.
**/node_modules/
**/host.json
**/.env
**/.env.*
**/*.log
**/*.zstd
**/*.pem
**/*.key
